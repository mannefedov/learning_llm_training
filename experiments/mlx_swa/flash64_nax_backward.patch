+#include "mlx/backend/metal/kernels/steel/attn/nax.h"
+
+// Register-resident NAX tiles with separate query/key ownership.
+template <bool QueryGradient, short QRows, short KRows>
+[[kernel]] void sdpa_vjp_flash64_nax(
+    const device float* q [[buffer(0)]],
+    const device float* k [[buffer(1)]],
+    const device float* v [[buffer(2)]],
+    const device float* grad_o [[buffer(3)]],
+    const device float* lse [[buffer(4)]],
+    const device float* delta [[buffer(5)]],
+    device float* grad_q [[buffer(6)]],
+    device float* grad_k [[buffer(7)]],
+    device float* grad_v [[buffer(8)]],
+    constant int& length [[buffer(9)]],
+    constant float& scale [[buffer(10)]],
+    constant int& window [[buffer(11)]],
+    uint3 group [[threadgroup_position_in_grid]]) {
+  using namespace mlx::steel;
+  constexpr int OwnedRows = QueryGradient ? QRows : KRows;
+  constexpr int OtherRows = QueryGradient ? KRows : QRows;
+  const int owned = int(group.x) * OwnedRows;
+  const size_t base = size_t(group.z) * length * 64;
+  const size_t row_base = size_t(group.z) * length;
+  NAXTile<float, OwnedRows / 16, 4> acc, acc_v;
+  acc.clear();
+  acc_v.clear();
+  const int first = QueryGradient
+      ? (window > 0 ? max(0, owned - window + 1) / OtherRows * OtherRows : 0)
+      : owned;
+  const int end = QueryGradient ? min(length, owned + OwnedRows)
+      : (window > 0 ? min(length, owned + OwnedRows + window - 1) : length);
+  for (int other = first; other < end; other += OtherRows) {
+    const int qi = QueryGradient ? owned : other;
+    const int kj = QueryGradient ? other : owned;
+    NAXTile<float, QRows / 16, 4> qt, ot;
+    NAXTile<float, KRows / 16, 4> kt, vt;
+    qt.load_safe(q + base + size_t(qi) * 64, 64, short2(64, min(int(QRows), length - qi)));
+    kt.load_safe(k + base + size_t(kj) * 64, 64, short2(64, min(int(KRows), length - kj)));
+    vt.load_safe(v + base + size_t(kj) * 64, 64, short2(64, min(int(KRows), length - kj)));
+    ot.load_safe(grad_o + base + size_t(qi) * 64, 64, short2(64, min(int(QRows), length - qi)));
+    NAXTile<float, QRows / 16, KRows / 16> prob, ds;
+    prob.clear();
+    ds.clear();
+    tile_matmad_nax(prob, qt, metal::false_type{}, kt, metal::true_type{});
+    tile_matmad_nax(ds, ot, metal::false_type{}, vt, metal::true_type{});
+    STEEL_PRAGMA_UNROLL
+    for (short r = 0; r < QRows / 16; ++r) {
+      STEEL_PRAGMA_UNROLL
+      for (short c = 0; c < KRows / 16; ++c) {
+        STEEL_PRAGMA_UNROLL
+        for (short e = 0; e < 8; ++e) {
+          const short2 coord = BaseNAXFrag::get_coord(e);
+          const int row = qi + r * 16 + coord.y;
+          const int col = kj + c * 16 + coord.x;
+          const bool allowed = row < length && col < length && col <= row &&
+              (window <= 0 || row - col < window);
+          float p = 0.f, g = 0.f;
+          if (allowed) {
+            p = metal::fast::exp(prob.frag_at(r,c)[e] * scale - lse[row_base + row]);
+            g = p * (ds.frag_at(r,c)[e] - delta[row_base + row]) * scale;
+          }
+          prob.frag_at(r,c)[e] = p;
+          ds.frag_at(r,c)[e] = g;
+        }
+      }
+    }
+    if constexpr (QueryGradient) {
+      tile_matmad_nax(acc, ds, metal::false_type{}, kt, metal::false_type{});
+    } else {
+      tile_matmad_nax(acc, ds, metal::true_type{}, qt, metal::false_type{});
+      tile_matmad_nax(acc_v, prob, metal::true_type{}, ot, metal::false_type{});
+    }
+  }
+  const short2 bounds(64, min(OwnedRows, length - owned));
+  if constexpr (QueryGradient) {
+    acc.store_safe(grad_q + base + size_t(owned) * 64, 64, bounds);
+  } else {
+    acc.store_safe(grad_k + base + size_t(owned) * 64, 64, bounds);
+    acc_v.store_safe(grad_v + base + size_t(owned) * 64, 64, bounds);
+  }
+}
+
+instantiate_kernel("sdpa_vjp_flash64_nax_16_dq", sdpa_vjp_flash64_nax, true, 16, 32);
+instantiate_kernel("sdpa_vjp_flash64_nax_16_dkv", sdpa_vjp_flash64_nax, false, 16, 32);
+instantiate_kernel("sdpa_vjp_flash64_nax_32_dq", sdpa_vjp_flash64_nax, true, 32, 32);
+instantiate_kernel("sdpa_vjp_flash64_nax_32_dkv", sdpa_vjp_flash64_nax, false, 32, 32);
+instantiate_kernel("sdpa_vjp_flash64_nax_64_dq", sdpa_vjp_flash64_nax, true, 32, 64);
+instantiate_kernel("sdpa_vjp_flash64_nax_64_dkv", sdpa_vjp_flash64_nax, false, 32, 64);
